@model Budgetverwaltung.ViewModels.TransactionFormViewModel

@{
    ViewData["Title"] = "Buchung bearbeiten";
}

<h1>Buchung bearbeiten</h1>

<div class="row">
    <div class="col-md-5">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">

            @* Die Id von der Buchung schicke ich versteckt mit, der Benutzer sieht sie nicht *@
            <input type="hidden" asp-for="Id" />

            @* Alle Felder kommen aus der gemeinsamen Datei *@
            <partial name="_TransactionFormFields" />

            <button type="submit" class="btn btn-primary">Speichern</button>
            <a asp-action="Index" class="btn btn-secondary">Abbrechen</a>
        </form>
    </div>
</div>

