@model Budgetverwaltung.ViewModels.TransactionFormViewModel

@{
    ViewData["Title"] = "Neue Buchung";
}

<h1>Neue Buchung</h1>

<div class="row">
    <div class="col-md-5">
        <form asp-action="Create" method="post">

            @* Alle Felder kommen aus der gemeinsamen Datei *@
            <partial name="_TransactionFormFields" />

            <button type="submit" class="btn btn-primary">Speichern</button>
            <a asp-action="Index" class="btn btn-secondary">Abbrechen</a>
        </form>
    </div>
</div>

